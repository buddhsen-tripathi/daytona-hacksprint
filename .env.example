# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Optional: leave empty to use long polling (no tunnel needed). Set both for webhook mode.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=

# ---- Operator API (#23) ----
# Bearer token for GET /api/* and POST /api/event on the bot API (everything except /api/health). The dashboard proxy sends it.
# Empty ⇒ local dev default: only loopback callers (127.0.0.1 / ::1) are trusted. Set it whenever the API is reachable from another host.
OPERATOR_API_TOKEN=
# Dashboard only: HTTP Basic auth password for a public deployment (any username). Empty ⇒ open.
DASHBOARD_PASSWORD=

# ---- OpenRouter ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_STT_MODEL=
# Agent memory embeddings (default openai/text-embedding-3-small, 1536 dims). No key ⇒ local hashed embedder.
OPENROUTER_EMBED_MODEL=
# On-disk embedding cache, relative to the repo root (default .runs/embed-cache; "off" disables it).
OPENROUTER_EMBED_CACHE_DIR=

# ---- Daytona (isolated filing worker) ----
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=
# local = run the worker as a child process (dev only). Auto: daytona when key present.
SANDBOX_PROVIDER=

# ---- Anchor Browser ----
ANCHOR_API_KEY=
# local = local Chrome via playwright-core (dev only). Auto: anchor when key present.
BROWSER_PROVIDER=

# ---- SurrealDB (empty URL = embedded mem://) ----
SURREALDB_URL=
SURREALDB_NAMESPACE=relay311
SURREALDB_DATABASE=main
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root

# ---- Arize Phoenix ----
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_API_KEY=
PHOENIX_PROJECT=311relay

# ---- NYC Open Data (optional app token raises rate limits) ----
NYC_OPEN_DATA_APP_TOKEN=

# ---- Filing ----
# Every filing targets the official form:
#   street-pothole       → NYC DOT pothole form: the worker fills the resident's details and stops at the reCAPTCHA;
#                          the resident finishes in the Anchor live view (first + last name required: /name).
#   street-repair-defect → NYC311 Street Repair route: hand-off with the official link.
#   subway-delay         → MTA Customer Feedback wizard (contact.mta.info), fully automated.
# ALLOW_REAL_SUBMIT unset ⇒ DRY RUN for the MTA form: the worker fills the whole form and stops before Submit
# (HUMAN_ACTION_REQUIRED + screenshot). Set to 1 to really submit, only for a genuine complaint the resident
# experienced and approved.
ALLOW_REAL_SUBMIT=
