# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Optional: leave empty to use long polling (no tunnel needed). Set both for webhook mode.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=

# ---- OpenRouter ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_STT_MODEL=

# ---- Daytona (isolated filing worker) ----
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=
# local = run the worker as a child process (dev only). Auto: daytona when key present.
SANDBOX_PROVIDER=

# ---- Anchor Browser ----
ANCHOR_API_KEY=
# local = local Chrome via playwright-core (dev only). Auto: anchor when key present.
BROWSER_PROVIDER=

# ---- SurrealDB (empty URL = embedded mem://) ----
SURREALDB_URL=
SURREALDB_NAMESPACE=relay311
SURREALDB_DATABASE=main
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root

# ---- Arize Phoenix ----
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_API_KEY=
PHOENIX_PROJECT=311relay

# ---- NYC Open Data (optional app token raises rate limits) ----
NYC_OPEN_DATA_APP_TOKEN=

# ---- Filing target ----
# demo  = controlled replica portal (apps/portal) — safe for repeated demos
# real  = official NYC DOT pothole form; only for a genuine complaint the user approves
FILING_TARGET=demo
# Subway delays (category subway-delay) have no replica: they ALWAYS go to the official MTA Customer
# Feedback form (contact.mta.info), regardless of FILING_TARGET. Unset ⇒ DRY RUN: the worker fills the
# whole form and stops before Submit (HUMAN_ACTION_REQUIRED + screenshot). Set to 1 to really submit,
# only for a genuine complaint the resident experienced and approved.
ALLOW_REAL_SUBMIT=
# URL of the demo portal as reachable FROM the browser (Anchor cloud browser needs a public URL, e.g. ngrok)
DEMO_PORTAL_URL=http://localhost:3311
